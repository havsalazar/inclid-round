<!-- Rounded outlined button with a centered label, used on the settings screen -->
<component>
	<api>
		<prop name="text" type="string" bindable="true" default="Button" help="The label on the button"/>
		<variants>
			<variant name="tone" options="normal danger" default="normal"/>
		</variants>
	</api>

	<styles>
		<style name="style_button" bg_color="{color_track}" bg_opa="100%" border_color="{color_accent}"
			border_width="2" radius="24" shadow_width="0" pad_hor="{space_md}" pad_ver="{space_xs}"
			text_color="{color_text}" text_font="font_small"/>
		<style name="style_button_pressed" bg_color="{color_accent}"/>
		<style name="style_button_disabled" border_color="{color_warn}" text_color="{color_warn}"/>
		<style name="style_button_danger" border_color="{color_danger}"/>
		<style name="style_button_danger_pressed" bg_color="{color_danger}"/>
	</styles>

	<view extends="lv_button" height="46">
		<style name="style_button"/>
		<style name="style_button_pressed" selector="pressed"/>
		<style name="style_button_disabled" selector="disabled"/>
		<style name="style_button_danger" enabled="{tone == danger}"/>
		<style name="style_button_danger_pressed" selector="pressed" enabled="{tone == danger}"/>

		<lv_label align="center" text="{text}"/>
	</view>

	<previews>
		<preview name="on_screen_bg" width="320" height="90" style_bg_color="0x000000"
			style_pad_all="20"/>
	</previews>
</component>
